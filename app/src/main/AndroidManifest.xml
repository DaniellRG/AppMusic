<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos de lectura de medios: granular en API 33+ (READ_MEDIA_AUDIO/IMAGES),
         o READ_EXTERNAL_STORAGE en API < 33 (maxSdkVersion=32 para no usarlo en 33+). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- La carátula de MediaStore está en content://media/external/audio/albumart y en
         API 33+ el ContentResolver la exige: sin este permiso la portada sale en negro.
         Opcional: si se deniega, la música sigue sonando y se ve el color por género. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Red: letras (lrclib) + portada (iTunes) online -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Reproducción en segundo plano: sin esto el servicio de sesión es un no-op en API 28+
         y no aparece la notificación. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- La notificación multimedia es la vía de control cuando la app está en segundo plano. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Music">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Music"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Publica la reproducción: notificación, pantalla de bloqueo, auriculares, Auto. -->
        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Botones de los auriculares: Media3 los reenvía a la sesión. -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>